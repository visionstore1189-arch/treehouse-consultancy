# Treehouse Consulting / Dawabit by Treehouse — v5
# Public build-time settings only; never store secrets in NEXT_PUBLIC_*.
# Canonical URL is fixed in src/lib/config.ts until the firm signs off E2.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# G1/G2: demo button is OFF until firm E2/E8 approves named users and
# Cloudflare Access protects custom domain, workers.dev and all previews.
NEXT_PUBLIC_DAWABIT_DEMO_ACCESS_APPROVED=false
NEXT_PUBLIC_DAWABIT_PROTECTED_DEMO_URL=

# N1/E4: security page, site menu and sitemap links are completely absent
# unless ALL fields below are genuinely verified and client-approved.
# These values are PUBLIC when activated. Never invent or imply approval.
NEXT_PUBLIC_DAWABIT_E4_SECURITY_APPROVED=false
NEXT_PUBLIC_DAWABIT_HOSTING_LOCATION_EN=
NEXT_PUBLIC_DAWABIT_HOSTING_LOCATION_AR=
NEXT_PUBLIC_DAWABIT_RETENTION_EN=
NEXT_PUBLIC_DAWABIT_RETENTION_AR=
NEXT_PUBLIC_DAWABIT_SAUDI_HOSTING_CONFIRMED=false
NEXT_PUBLIC_DAWABIT_DOCUMENTS_NOT_USED_FOR_TRAINING=false

# E1/E3: inquiry forms are not turned on by environment alone.
# They require approved legal text, monitored email, live Turnstile,
# Cloudflare Pages D1/Resend secrets and explicit application release.
# Refer to docs/DEPLOYMENT.md, not an unapproved example credential.
